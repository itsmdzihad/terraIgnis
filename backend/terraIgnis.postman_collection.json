    {
      "name": "Data pipeline",
      "description": "Manual multi-file upload and dataset generation controls used by the frontend pipeline page.",
      "item": [
        {
          "name": "Upload raw files (batch)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/pipeline/uploads/batch",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "pipeline",
                "uploads",
                "batch"
              ]
            },
            "description": "Upload one batch of same-sensor FIRMS text or CSV files. Set sensor to MODIS or VIIRS and attach each file under the repeated files field.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "sensor",
                  "value": "MODIS",
                  "type": "text"
                },
                {
                  "key": "files",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "files",
                  "type": "file",
                  "src": ""
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Pipeline status",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Returns raw-file inventory, current generation progress, and last_successful_at / last_successful_job_id for the most recently published datasets.",
            "url": {
              "raw": "{{base_url}}/api/pipeline/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "pipeline",
                "status"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Generate datasets",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/pipeline/generate",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "pipeline",
                "generate"
              ]
            },
            "description": "Starts the six-stage dataset generation workflow. Poll Pipeline status to follow progress."
          },
          "response": []
        },
        {
          "name": "Clear all FIRMS data",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"{{data_reset_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Destructive: permanently deletes raw FIRMS files, generated datasets, reports, and ingestion history. Requires DATA_RESET_PASSWORD and returns 409 while ingestion or generation is active.",
            "url": {
              "raw": "{{base_url}}/api/pipeline/reset",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "pipeline",
                "reset"
              ]
            }
          },
          "response": []
        }
      ]
    }
